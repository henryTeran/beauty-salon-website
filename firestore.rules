rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Seul ce compte peut gérer les horaires et voir le planning
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['rodmafer6@gmail.com'];
    }

    // Horaires de travail : visibles par tous, modifiables par l'admin
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Créneaux occupés (aucune donnée personnelle) : visibles par tous
    match /busy/{id} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['date', 'start', 'end'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start is int
        && request.resource.data.end is int
        && request.resource.data.start >= 0
        && request.resource.data.end <= 1440
        && request.resource.data.end > request.resource.data.start
        // uniquement en même temps qu'une demande de rendez-vous
        && existsAfter(/databases/$(database)/documents/bookings/$(id))
      );
      allow update, delete: if isAdmin();
    }

    // Demandes de rendez-vous : tout le monde peut en créer une, seul l'admin peut les lire
    match /bookings/{id} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.start is int && request.resource.data.end is int
        && request.resource.data.services is list && request.resource.data.services.size() <= 20
        && request.resource.data.address is string && request.resource.data.address.size() <= 300
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }
  }
}
